# Antigravity Agent Hub Environment Variables
# Copy this file to .env and fill in your actual values

# Firebase Configuration (optional, for Firebase integration)
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id

# OpenAI Configuration (optional, for AI-powered agents)
OPENAI_API_KEY=your-openai-api-key

# Backend Configuration
API_HOST=0.0.0.0
API_PORT=8000

# CORS Configuration (comma-separated list of allowed origins)
# Use * for development, restrict to specific domains in production
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
